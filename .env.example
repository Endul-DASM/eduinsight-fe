# Backend base URL, e.g. https://api.eduinsight.id/v1
# Locally, run eduinsight-be and use http://localhost:8000/v1
# Leave unset to run the app on the mock data in lib/api/mocks.ts (no login needed).
API_BASE_URL=

# Google OAuth client ID for "Masuk dengan Google" (the client secret stays in the backend).
# Register <app origin>/auth/google/callback as a redirect URI. Leave unset to hide Google sign-in behind a message.
GOOGLE_CLIENT_ID=
